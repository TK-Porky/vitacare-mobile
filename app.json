{
  "expo": {
    "name": "VitaCare",
    "slug": "vitacare",
    "version": "1.1.0",
    "scheme": "vitacare",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/images/logo/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "VitaCare utilise votre position pour trouver des établissements de santé à proximité."
      },
      "bundleIdentifier": "com.searl.vitacare"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.searl.vitacare",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "VitaCare utilise votre position pour trouver des établissements de santé à proximité."
        }
      ],
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo/adaptive-icon.png",
          "color": "#22c55e"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/logo/splash.png",
          "dark": {
            "image": "./assets/images/logo/splash.png",
            "backgroundColor": "#000000"
          },
          "imageWidth": 200
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-sharing",
      "@react-native-google-signin/google-signin",
      "expo-web-browser",
      "@react-native-firebase/messaging",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8c02fb68-3a58-4e02-a4c5-e082ab114a0d"
      }
    },
    "owner": "tk-porkys-team"
  }
}
